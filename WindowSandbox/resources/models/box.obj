# Box model in OBJ format
# Vertices
v -1.0 -1.0 -1.0
v 1.0 -1.0 -1.0
v 1.0 1.0 -1.0
v -1.0 1.0 -1.0
v -1.0 -1.0 1.0
v 1.0 -1.0 1.0
v 1.0 1.0 1.0
v -1.0 1.0 1.0

# Faces (each face is composed of three vertex indices)
# Front face (counter-clockwise winding)
f 1 3 2
f 1 4 3
# Back face (counter-clockwise winding)
f 5 7 8
f 5 6 7
# Left face (counter-clockwise winding)
f 1 6 5
f 1 2 6
# Right face (counter-clockwise winding)
f 2 7 6
f 2 3 7
# Top face (counter-clockwise winding)
f 4 7 3
f 4 8 7
# Bottom face (counter-clockwise winding)
f 1 5 8
f 1 8 4