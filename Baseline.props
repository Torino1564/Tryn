<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <IncludePath>$(SolutionDir);$(IncludePath)</IncludePath>
    <CodeAnalysisRuleSet>..\Baseline.ruleset</CodeAnalysisRuleSet>
    <RunCodeAnalysis>true</RunCodeAnalysis>
    <ExcludePath>E:\RivaTuner Statistics Server;$(ExcludePath)</ExcludePath>
    <EnableClangTidyCodeAnalysis>false</EnableClangTidyCodeAnalysis>
    <LibraryPath>$(SolutionDir)vcpkg_installed\$(VcpkgTriplet)\$(VcpkgTriplet)\lib;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
	<VcpkgUseStatic>true</VcpkgUseStatic>
	<VcpkgUseMD>true</VcpkgUseMD>
	<VcpkgTriplet>$(Platform)-windows-static-md</VcpkgTriplet>
	<VcpkgHostTriplet>$(Platform)-windows-static-md</VcpkgHostTriplet>
  </PropertyGroup>
  <PropertyGroup>
	<VcpkgLibDir Condition="'$(Configuration)'=='Debug'">$(SolutionDir)vcpkg_installed\$(VcpkgTriplet)\$(VcpkgTriplet)\debug\lib</VcpkgLibDir>
	<VcpkgLibDir Condition="'$(Configuration)'=='Release'">$(SolutionDir)vcpkg_installed\$(VcpkgTriplet)\$(VcpkgTriplet)\lib</VcpkgLibDir>
	<VcpkgRspFile>$(SolutionDir)vcpkg_libs.rsp</VcpkgRspFile>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <EnableASAN>false</EnableASAN>
    <EnableFuzzer>false</EnableFuzzer>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <UseStandardPreprocessor>true</UseStandardPreprocessor>
      <FloatingPointModel>Fast</FloatingPointModel>
      <EnforceTypeConversionRules>true</EnforceTypeConversionRules>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(VULKAN_SDK)\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_SILENCE_ALL_CXX23_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <InlineFunctionExpansion>Disabled</InlineFunctionExpansion>
      <EnableParallelCodeGeneration>true</EnableParallelCodeGeneration>
      <Optimization>Disabled</Optimization>
      <MinimalRebuild>false</MinimalRebuild>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgLibDir);$(VULKAN_SDK)\Lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <GenerateDebugInformation>DebugFastLink</GenerateDebugInformation>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
      <AdditionalDependencies>%(AdditionalDependencies) @$(VcpkgRspFile)</AdditionalDependencies>
    </Link>
    <FxCompile>
      <ObjectFileOutput>$(SolutionDir)bin\Shaders\%(Filename).cso</ObjectFileOutput>
      <DisableOptimizations>true</DisableOptimizations>
      <EnableDebuggingInformation>true</EnableDebuggingInformation>
    </FxCompile>
  </ItemDefinitionGroup>
  <ItemGroup />
  <Target Name="WriteVcpkgRsp" BeforeTargets="Link">
	<ItemGroup>
		<VcpkgLibFiles Include="$(VcpkgLibDir)\*.lib"/>
	</ItemGroup>
	<WriteLinesToFile
		File="$(VcpkgRspFile)"
		Lines="@(VcpkgLibFiles->'%(FullPath)')"
		Overwrite="true"
		WriteOnlyWhenDifferent="true"/>

	<Message Text="Found libs: @(VcpkgLibFiles)" Importance="high"/>
	<Message Text="Rsp file written to: $(VcpkgRspFile)" Importance="high"/>
	<Message Text="Written rsp: %(Link.AdditionalDependencies)" Importance="high"/>
  </Target>
</Project>